# Comma-separated browser origins. Use the exact LAN URL when testing on a board.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
# Optional: Single or comma-separated multiple free Gemini keys for automatic rate-limit rotation:
# Example: GEMINI_API_KEYS=AIzaSyKey1,AIzaSyKey2,AIzaSyKey3
GEMINI_API_KEY=
GEMINI_API_KEYS=
# Optional: Single or comma-separated OpenRouter keys for automatic failover when Gemini hits 429/quota:
# Example: OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2
OPENROUTER_API_KEY=
OPENROUTER_API_KEYS=
# Optional runtime label for deployments.
APP_ENV=local
# Set true in school deployments. Generate tokens through your OIDC gateway or
# the compatible HMAC format documented in docs/MODE2_PRODUCTION_RUNBOOK.md.
STUDENT_CONTEXT_REQUIRE_AUTH=false
STUDENT_CONTEXT_SECRET=local-development-secret
STUDENT_CONTEXT_DB=.data/student_context.sqlite3

# Trục tam giác (hub, /api/v1/hub/*): dữ liệu mẫu cho demo (giáo viên gv-demo, lớp 12A1/11A2, 8 học sinh)
# Hub LUÔN kiểm token; ở production phải đặt STUDENT_CONTEXT_SECRET >= 32 ký tự, nếu không hub trả 503.
HUB_DEMO_PIN=2468
HUB_SEED=true
# Địa chỉ app học sinh (đỉnh 3) để dựng link/QR giao bài: <STUDENT_APP_URL>/a/<mã>
STUDENT_APP_URL=http://localhost:3002
