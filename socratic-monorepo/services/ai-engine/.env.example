# Comma-separated browser origins. Use the exact LAN URL when testing on a board.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Optional: enables Gemini Vision instead of deterministic OCR/heuristics.
GEMINI_API_KEY=
# Optional runtime label for deployments.
APP_ENV=local
# Set true in school deployments. Generate tokens through your OIDC gateway or
# the compatible HMAC format documented in docs/MODE2_PRODUCTION_RUNBOOK.md.
STUDENT_CONTEXT_REQUIRE_AUTH=false
STUDENT_CONTEXT_SECRET=local-development-secret
STUDENT_CONTEXT_DB=.data/student_context.sqlite3
