# Biến môi trường cho bản công khai (Render). Không commit giá trị thật; nhập trong Render → Environment.
APP_ENV=production
# Địa chỉ giao diện được gọi thẳng máy chủ (ngăn bằng dấu phẩy, không dấu / cuối)
CORS_ORIGINS=https://socratic-board.vercel.app,https://socratic-student.vercel.app
# Cho phép mọi địa chỉ xem trước của Vercel (tùy chọn)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
# Số lời gọi AI tốn khóa máy chủ mỗi phút trên mỗi IP
RATE_LIMIT_PER_MIN=90
# Khóa quản trị để ghi khóa AI qua API (để trống = tắt hẳn việc ghi khóa qua API)
ADMIN_TOKEN=
# Khóa AI (nhiều khóa ngăn bằng dấu phẩy để tự xoay vòng)
GEMINI_API_KEYS=
OPENROUTER_API_KEYS=
# Ngữ cảnh học sinh: bật xác thực khi có học sinh thật
STUDENT_CONTEXT_REQUIRE_AUTH=false
STUDENT_CONTEXT_SECRET=replace-with-a-32-plus-character-secret
