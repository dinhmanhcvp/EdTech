# Biến môi trường cho bản công khai (Render). Không commit giá trị thật; nhập trong Render → Environment.
APP_ENV=production
# Địa chỉ giao diện được gọi thẳng máy chủ (ngăn bằng dấu phẩy, không dấu / cuối)
CORS_ORIGINS=https://socratic-board.vercel.app,https://socratic-student.vercel.app
# Cho phép mọi địa chỉ xem trước của Vercel (tùy chọn)
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
# Số lời gọi AI tốn khóa máy chủ mỗi phút trên mỗi IP
RATE_LIMIT_PER_MIN=90
# Khóa quản trị để ghi khóa AI qua API (để trống = tắt hẳn việc ghi khóa qua API)
ADMIN_TOKEN=
# AI Vision chỉ qua OpenRouter (mặc định). Đặt auto|gemini để dùng thêm khóa Gemini trực tiếp
VISION_PROVIDER=auto
# Số lượt tối đa mỗi phút cho mỗi khóa Gemini (thấp hơn hạn mức thật để không chạm 429)
GEMINI_RPM_PER_KEY=8
# Hạn mức THẬT từng model (xem trang Rate limit của AI Studio): model:rpm:rpd. Model RPD lớn dành cho Vision, hỏi đáp, gia sư;
# model RPD nhỏ chỉ đỡ khi model lớn hết 90% lượt trong ngày. Chưa đặt thì dùng số giả định và tự học từ lỗi 429.
# GEMINI_MODEL_LIMITS=gemini-3-flash-preview:10:250,gemini-2.5-flash:10:250,gemini-2.5-flash-lite:15:1000
# Tùy chọn: ghi đè danh sách model (model đầu thử trước). Mặc định đã đo thật ngày 2026-10-29
# GEMINI_VISION_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
# GEMINI_QA_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash
# Khóa OpenRouter (nhiều khóa ngăn bằng dấu phẩy để tự xoay vòng)
OPENROUTER_API_KEYS=
# Tùy chọn: danh sách model Vision, model đầu thử trước
# OPENROUTER_VISION_MODELS=google/gemini-2.5-flash,google/gemini-2.5-flash-lite,qwen/qwen3-vl-30b-a3b-instruct,openai/gpt-4o-mini
# Nhiều khóa Gemini ngăn bằng dấu phẩy, mỗi khóa từ một dự án Google khác nhau
GEMINI_API_KEYS=
# Ngữ cảnh học sinh: bật xác thực khi có học sinh thật
STUDENT_CONTEXT_REQUIRE_AUTH=false
STUDENT_CONTEXT_SECRET=replace-with-a-32-plus-character-secret
