{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@socratic/types": ["packages/types/src/index.ts"],
      "@socratic/ui": ["packages/ui/src/index.tsx"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
